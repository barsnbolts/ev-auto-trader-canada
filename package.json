{
  "name": "ev-auto-trader-canada",
  "version": "0.1.0",
  "private": true,
  "description": "Canadian inventory + incentives tracker for Kia EV6, Hyundai Ioniq 5, Hyundai Ioniq 6 (and N/GT trims), GTA-focused.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "thermal-audit": "python3 scripts/validate_thermal_specs.py",
    "schema-audit": "python3 scripts/validate_data_schemas.py",
    "predeploy": "npm run typecheck && npm run thermal-audit && npm run schema-audit && npm run build",
    "static-meta": "python3 scripts/build_static_meta.py",
    "build:tauri:web": "BUILD_TARGET=tauri npm run static-meta && BUILD_TARGET=tauri next build",
    "predeploy:tauri": "npm run typecheck && npm run thermal-audit && npm run schema-audit && npm run build:tauri:web",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "tauri": "tauri",
    "icon": "tauri icon ./assets/ev-monogram-1024.png",
    "snapshot": "node scripts/snapshot.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@travishorn/financejs": "^1.19.1",
    "leaflet": "^1.9.4",
    "next": "^15.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.13.3",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.3",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
