{
  "vehicle": {
    "brand": "Hyundai",
    "model": "Kona Electric",
    "year": 2025,
    "trim": "Long Range"
  },
  "agents": [
    {
      "agent_id": "battery_and_chemistry",
      "fields": [
        "battery_kwh_total",
        "battery_kwh_usable",
        "battery_chemistry"
      ],
      "primary": {
        "tool": "web_fetch",
        "url_template": "https://ev-database.org/?search=1&q={brand}+{model}",
        "extract": "Pick the trim row matching the year+trim. Pull total + usable kWh and chemistry (NMC/LFP/NCA).",
        "url": "https://ev-database.org/?search=1&q=Hyundai+Kona Electric"
      },
      "fallback": [
        {
          "tool": "web_search",
          "query": "Hyundai Kona Electric 2025 battery kWh total usable chemistry"
        },
        {
          "tool": "web_fetch",
          "url_template": "https://insideevs.com/?s={brand}+{model}+{year}",
          "extract": "battery",
          "url": "https://insideevs.com/?s=Hyundai+Kona Electric+2025"
        }
      ]
    },
    {
      "agent_id": "range_and_protocol",
      "fields": [
        "range_km",
        "range_protocol"
      ],
      "primary": {
        "tool": "web_fetch",
        "url_template": "https://www.fueleconomy.gov/feg/PowerSearch.do?action=noform&path=1&year1={year}&year2={year}&make={brand}",
        "extract": "Find the matching trim. Convert miles \u2192 km if needed. Note whether protocol is EPA or WLTP.",
        "url": "https://www.fueleconomy.gov/feg/PowerSearch.do?action=noform&path=1&year1=2025&year2=2025&make=Hyundai"
      },
      "fallback": [
        {
          "tool": "web_search",
          "query": "Hyundai Kona Electric 2025 EPA range miles km Canada"
        }
      ]
    },
    {
      "agent_id": "charging",
      "fields": [
        "ac_charge_kw_max",
        "dc_charge_kw_max",
        "port_type",
        "charging_curve_20c"
      ],
      "primary": {
        "tool": "web_fetch",
        "url_template": "https://ev-database.org/?search=1&q={brand}+{model}",
        "extract": "AC max (standard onboard charger), DC peak kW, port type (CCS1/NACS/CCS2). Curve from EVKX.net or Fastned if available.",
        "url": "https://ev-database.org/?search=1&q=Hyundai+Kona Electric"
      },
      "fallback": [
        {
          "tool": "web_search",
          "query": "Hyundai Kona Electric 2025 DC fast charging speed kW peak curve"
        },
        {
          "tool": "web_fetch",
          "url_template": "https://evkx.net/models/{brand}/",
          "extract": "charging curve",
          "url": "https://evkx.net/models/Hyundai/"
        }
      ]
    },
    {
      "agent_id": "thermal",
      "fields": [
        "has_heat_pump",
        "thermal_management",
        "cold_derate_curve",
        "hvac_draw_kw_by_temp",
        "hp_min_temp_c",
        "precon_time_by_temp",
        "precon_thermal_gain",
        "dc_cold_soak_curve"
      ],
      "primary": {
        "tool": "web_search",
        "query": "Hyundai Kona Electric heat pump cold weather range loss Bjorn Nyland Recurrent",
        "extract": "Determine: heat pump yes/no. Model class peer for cold-derate curve (NMC vs LFP). Use peer's curve as starting point."
      },
      "fallback": [
        {
          "tool": "web_fetch",
          "url_template": "https://www.recurrentauto.com/research/winter-ev-range-loss",
          "extract": "model peer",
          "url": "https://www.recurrentauto.com/research/winter-ev-range-loss"
        },
        {
          "tool": "web_fetch",
          "url_template": "https://support.fastned.nl/hc/en-gb/articles/360007516494",
          "extract": "cold-soak curve",
          "url": "https://support.fastned.nl/hc/en-gb/articles/360007516494"
        }
      ]
    },
    {
      "agent_id": "physical",
      "fields": [
        "seats",
        "cargo_l_seats_up",
        "cargo_l_seats_down",
        "tow_rating_kg",
        "weight_kg",
        "body_style"
      ],
      "primary": {
        "tool": "web_fetch",
        "url_template": "https://www.{brand_lower}.ca/en/models/{model_slug}.html",
        "extract": "OEM Canadian spec sheet \u2014 body style, seats, cargo L (seats up + down), curb weight kg, tow rating kg.",
        "url": "https://www.hyundai.ca/en/models/kona-electric.html"
      },
      "fallback": [
        {
          "tool": "web_search",
          "query": "Hyundai Kona Electric 2025 cargo litres curb weight kg tow rating Canada"
        }
      ]
    },
    {
      "agent_id": "pricing_and_rebates",
      "fields": [
        "msrp_cad",
        "federal_izev_cad",
        "provincial_rebate_cad_on"
      ],
      "primary": {
        "tool": "web_search",
        "query": "Hyundai Kona Electric 2025 Canada MSRP CAD price trim",
        "extract": "Use the trim's CAD MSRP. iZEV: paused as of 2026 \u2192 0. Ontario provincial rebate: none \u2192 0."
      },
      "fallback": [
        {
          "tool": "web_fetch",
          "url_template": "https://www.autotrader.ca/research/{brand_lower}/{model_lower}/{year}/",
          "extract": "trim MSRP",
          "url": "https://www.autotrader.ca/research/hyundai/kona-electric/2025/"
        },
        {
          "tool": "web_search",
          "query": "iZEV program status 2026 Canada"
        }
      ]
    }
  ],
  "instruction_to_orchestrator": "Spawn one general-purpose Agent per agent_id, ALL IN A SINGLE TOOL MESSAGE so they run in parallel. Each agent fetches the primary URL or runs the primary search, extracts only the listed fields, and returns a JSON object with {field_name: {value, confidence (H/M/L), source_url, source_name, accessed (today)}}. If primary fails, the agent tries fallbacks in order before reporting Low confidence with a 'data not located' note. The orchestrator (me) merges the JSON blobs into the seed.json schema."
}
