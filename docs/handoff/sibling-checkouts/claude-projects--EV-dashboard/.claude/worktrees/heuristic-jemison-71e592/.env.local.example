# Copy to .env.local (gitignored) and set the values you need.

# Debug mode: enables the DebugPanel overlay (⌘⇧D) and writes structured
# events to logs/debug/<YYYY-MM-DD>.jsonl via the Vite dev plugin.
# Default unset = off, zero runtime cost.
VITE_DEBUG=1

# External API keys (all optional; the app ships working fallbacks for each).
# See docs/external_keys.md for how to generate.
# VITE_APPLE_MAPKIT_TOKEN=
# VITE_OCM_API_KEY=
# VITE_ABRP_API_KEY=
# VITE_MAPBOX_TOKEN=

# Python-side research bindings (scripts/research_client.py).
# Optional — without these, scripts/research*.py fall through to MCP dispatch.
# EXA_API_KEY=
# APIFY_API_TOKEN=
